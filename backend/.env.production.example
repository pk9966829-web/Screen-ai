# Copy to backend/.env and replace every placeholder before deployment.
VOSI_DOMAIN=api.example.com

# Required secrets: generate unique random values and keep them out of Git.
VOSI_MULTI_TENANT=true
VOSI_AGENT_TOKEN=replace_with_a_long_random_secret
VOSI_IDENTITY_CHALLENGE_SECRET=replace_with_at_least_32_random_characters

# Set the exact HTTPS origins allowed to call the API from browsers/WebViews.
# Include only your deployed VOSI frontend origins.
VOSI_CORS_ORIGINS=https://app.example.com

# AI provider (OpenAI-compatible).
OPENAI_API_KEY=replace_with_provider_key
OPENAI_BASE_URL=https://api.openai.com/v1
VOSI_MODEL=gpt-6

# Email verification delivery (STARTTLS, normally port 587).
VOSI_SMTP_HOST=smtp.example.com
VOSI_SMTP_PORT=587
VOSI_SMTP_USERNAME=replace_with_smtp_username
VOSI_SMTP_PASSWORD=replace_with_smtp_password
VOSI_SMTP_FROM=no-reply@example.com

# Optional provider failover.
# VOSI_PROVIDER_CHAIN=groq,openrouter
# VOSI_GROQ_API_KEY=
# VOSI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# VOSI_GROQ_MODEL=
