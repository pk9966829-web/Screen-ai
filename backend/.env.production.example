# Copy to backend/.env and replace every placeholder before deployment.
VOSI_DOMAIN=api.example.com
# Public API origin used in the QR payload and email approval links.
VOSI_PUBLIC_API_URL=https://api.example.com

# Required secrets: generate unique random values and keep them out of Git.
VOSI_MULTI_TENANT=true
VOSI_AGENT_TOKEN=replace_with_a_long_random_secret
VOSI_IDENTITY_CHALLENGE_SECRET=replace_with_at_least_32_random_characters
# Google OAuth Web client ID. Add this frontend origin to Google Cloud Authorized JavaScript origins.
VOSI_GOOGLE_CLIENT_ID=your_google_web_client_id

# Set the exact HTTPS origins allowed to call the API from browsers/WebViews.
# Include only your deployed VOSI frontend origins.
VOSI_CORS_ORIGINS=https://app.example.com,tauri://localhost

# AI provider (OpenAI-compatible).
OPENAI_API_KEY=replace_with_provider_key
OPENAI_BASE_URL=https://api.openai.com/v1
VOSI_MODEL=gpt-6

VOSI_EMAIL_PROVIDER=smtp
# Transactional email delivery (STARTTLS, normally port 587).
VOSI_SMTP_HOST=smtp.example.com
VOSI_SMTP_PORT=587
VOSI_SMTP_USERNAME=replace_with_smtp_username
VOSI_SMTP_PASSWORD=replace_with_smtp_password
VOSI_SMTP_FROM=no-reply@example.com

# Optional provider failover.
# VOSI_PROVIDER_CHAIN=groq,openrouter
# VOSI_GROQ_API_KEY=
# VOSI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# VOSI_GROQ_MODEL=

# Optional read-only cloud browser worker. Set a separate long random worker secret.
# Set these same values for the API and optional cloud-browser-worker service.
VOSI_CLOUD_WORKER_TOKEN=replace_with_a_separate_worker_secret
VOSI_CLOUD_WORKER_ID=browser-worker-1
VOSI_CLOUD_WORKER_PLATFORM=browser
VOSI_CLOUD_WORKER_CAPABILITIES=browser.search_products
VOSI_CLOUD_WORKER_LEASE_SECONDS=180
# Required only for the cloud-browser-worker service in multi-tenant mode.
# Use a dedicated VOSI account session and keep it secret.
VOSI_CLOUD_WORKER_ACCOUNT_TOKEN=


# Optional CHERRY AI Exotel receptionist (caller consent is required; audio is not recorded).
CHERRY_CALL_RECEPTIONIST_ENABLED=false
CHERRY_EXOTEL_STREAM_USER=cherry
CHERRY_EXOTEL_STREAM_PASSWORD=replace_with_a_long_random_secret
CHERRY_LIVE_API_KEY=
CHERRY_LIVE_MODEL=gpt-live-1.1
CHERRY_LIVE_VOICE=marin
CHERRY_CALL_SUMMARY_AI_ENABLED=false
CHERRY_CALL_OWNER_USER_ID=

# Optional Fish Audio S2 TTS. GPT-Live stays the default/fallback unless configured.
CHERRY_TTS_PROVIDER=gpt-live
CHERRY_FISH_API_KEY=
CHERRY_FISH_VOICE_ID=
CHERRY_FISH_MODEL=s2.1-pro
CHERRY_FISH_SAMPLE_RATE=16000
CHERRY_FISH_EMOTION_TAGS=true
