{$VOSI_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(self), display-capture=(self), geolocation=()"
        -Server
    }

    reverse_proxy api:8001
}
