# Copy to .env or set these variables in PowerShell.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://localhost:20128/v1
VOSI_MODEL=gemini/gemini-2.5-flash

# VOSI execution agent (generate a long random value; never commit .env)
VOSI_API_TOKEN=replace_with_a_long_random_secret
VOSI_AGENT_MODEL=gemini/gemini-2.5-flash
VOSI_PERCEPTION_MODEL=gemini/gemini-2.5-flash
VOSI_AGENT_DB_PATH=./data/vosi_agent.db
VOSI_AUTONOMY_PROFILE=approval
VOSI_ENV=dev
