# Copy to .env or set these variables in PowerShell.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://localhost:20128/v1
VOSI_MODEL=gemini/gemini-2.5-flash

# Required to enable the VOSI agent planning and device-management API.
# Generate a long random secret; never commit your real .env file.
VOSI_AGENT_TOKEN=replace_with_a_long_random_secret
# Optional: keep agent tasks and paired devices in a dedicated SQLite database.
# VOSI_AGENT_DB_PATH=./vosi_agent.db

# Optional OpenAI-compatible provider failover order. Each named provider needs all 3 values.
# Example: VOSI_PROVIDER_CHAIN=groq,openrouter
# VOSI_GROQ_API_KEY=
# VOSI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# VOSI_GROQ_MODEL=
# VOSI_OPENROUTER_API_KEY=
# VOSI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VOSI_OPENROUTER_MODEL=
# The existing OPENAI_API_KEY / OPENAI_BASE_URL / VOSI_MODEL configuration remains the fallback.
# Optional separate location for persistent companion memories:
# VOSI_COMPANION_DB_PATH=./vosi_companion.sqlite3

# VOSI shared account identity (required before account registration is enabled).
# Generate a random secret of at least 32 characters; keep it in your deployment secret manager.
# PowerShell example: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
VOSI_IDENTITY_CHALLENGE_SECRET=replace_with_a_long_random_secret

# SMTP delivery for six-digit email verification codes (STARTTLS, normally port 587).
VOSI_SMTP_HOST=smtp.example.com
VOSI_SMTP_PORT=587
VOSI_SMTP_USERNAME=your_smtp_username
VOSI_SMTP_PASSWORD=your_smtp_password
VOSI_SMTP_FROM=no-reply@example.com
