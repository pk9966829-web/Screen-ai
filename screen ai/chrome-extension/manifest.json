{
  "manifest_version": 3,
  "name": "VOSI Browser Companion",
  "version": "1.1.0",
  "description": "Pair Chrome securely with VOSI and search visible Flipkart product listings.",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "https://www.flipkart.com/*"
  ],
  "action": {
    "default_title": "VOSI Browser Companion",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://www.flipkart.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}